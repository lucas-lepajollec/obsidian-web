# Docker: host directory mounted into the container.
SHARDNOTE_VAULT_PATH=./vault

# Local Node.js development: absolute path or path relative to the project.
NOTES_PATH=./vault

# Required: at least 12 characters.
SHARDNOTE_PASSWORD=replace-with-a-long-unique-password

# Required: at least 32 random characters. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHARDNOTE_SESSION_SECRET=replace-with-at-least-32-random-characters

# Optional. When true, notes can be read without signing in; editing stays private.
SHARDNOTE_PUBLIC_READ=false

# Keep true behind HTTPS. Set false only for direct HTTP access on a trusted LAN.
SHARDNOTE_SECURE_COOKIES=true
